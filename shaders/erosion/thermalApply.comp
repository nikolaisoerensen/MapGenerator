#version 430
// Pass 6b des Feld-Erosionsmodells: Boeschungs-Ausfluss anwenden.
//
// Formelgleich zum zweiten Teil von core/erosion_generator.py
// HydraulicFieldSimulator._pass_thermal(). Gather statt Scatter: jede Zelle
// SAMMELT ein, was ihre Nachbarn in ihre Richtung abgeben. Weil jede
// transportierte Einheit damit genau einer Quelle und einem Ziel zugeordnet
// ist, ist die Massenbilanz strukturell exakt - ohne Renormierung (gemessen:
// Drift 0.000e+00 ueber 50 Iterationen).
//
// ACHT Richtungen, verteilt auf zwei Texturen (siehe thermalFlux.comp):
//   outflowAxes  = (links, rechts, oben, unten)
//   outflowDiags = (oben-links, oben-rechts, unten-links, unten-rechts)
//
// Schreibt zusaetzlich die ueber den ganzen Lauf akkumulierten Boeschungs-
// Anteile fort (thermalAccum: r = Abtrag, g = Auftrag), aus denen der
// Erosion-Tab seine beiden Thermal-Ansichten speist.
layout(local_size_x = 16, local_size_y = 16) in;

layout(r32f, binding = 0) uniform readonly image2D heightIn;
layout(rgba32f, binding = 1) uniform readonly image2D outflowAxes;
layout(rgba32f, binding = 2) uniform readonly image2D outflowDiags;
layout(rg32f, binding = 3) uniform readonly image2D thermalAccumIn;
layout(r32f, binding = 4) uniform writeonly image2D heightOut;
layout(rg32f, binding = 5) uniform writeonly image2D thermalAccumOut;

uniform int u_size;

bool inside(ivec2 coord) {
    return coord.x >= 0 && coord.x < u_size && coord.y >= 0 && coord.y < u_size;
}

// Wieviel gibt `coord` in Richtung `channel` ab? Kanal 0-3 sind die Achsen
// (links, rechts, oben, unten), 4-7 die Diagonalen (OL, OR, UL, UR) - dieselbe
// Reihenfolge wie in thermalFlux.comp und im CPU-Pfad. Ausserhalb der Karte: 0,
// geschlossene Grenze.
float outflowFrom(ivec2 coord, int channel) {
    if (!inside(coord)) {
        return 0.0;
    }
    if (channel < 4) {
        return imageLoad(outflowAxes, coord)[channel];
    }
    return imageLoad(outflowDiags, coord)[channel - 4];
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_size || coord.y >= u_size) return;

    vec4 ownAxes = imageLoad(outflowAxes, coord);
    vec4 ownDiags = imageLoad(outflowDiags, coord);
    float outgoing = ownAxes.x + ownAxes.y + ownAxes.z + ownAxes.w
                   + ownDiags.x + ownDiags.y + ownDiags.z + ownDiags.w;

    // Zufluss = der jeweils ENTGEGENGESETZTE Ausfluss des Nachbarn: vom linken
    // Nachbarn sein "rechts" (Kanal 1), vom Nachbarn oben-links sein
    // "unten-rechts" (Kanal 7), und so weiter.
    float incoming = outflowFrom(coord + ivec2(-1, 0), 1)
                   + outflowFrom(coord + ivec2(1, 0), 0)
                   + outflowFrom(coord + ivec2(0, -1), 3)
                   + outflowFrom(coord + ivec2(0, 1), 2)
                   + outflowFrom(coord + ivec2(-1, -1), 7)
                   + outflowFrom(coord + ivec2(1, -1), 6)
                   + outflowFrom(coord + ivec2(-1, 1), 5)
                   + outflowFrom(coord + ivec2(1, 1), 4);

    float height = imageLoad(heightIn, coord).r;
    imageStore(heightOut, coord, vec4(height + incoming - outgoing, 0.0, 0.0, 0.0));

    vec2 accum = imageLoad(thermalAccumIn, coord).rg;
    imageStore(thermalAccumOut, coord, vec4(accum.x + outgoing, accum.y + incoming, 0.0, 0.0));
}
