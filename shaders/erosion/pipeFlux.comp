#version 430
// Pass 1+2 des Feld-Erosionsmodells: Regen und Fluss-Update.
//
// Formelgleich zu core/erosion_generator.py
// HydraulicFieldSimulator._pass_rain() + _pass_flux_and_depth() (erster Teil).
// Der CPU-Pfad ist die verifizierbare Referenz - jede Abweichung hier ist ein
// Fehler, keine Optimierung.
//
// WARUM DER REGEN HIER MITLAEUFT statt in einem eigenen Pass: er ist eine
// UNIFORME Rate ueber die ganze Karte. `water + rate*dt` auf jede Zelle
// anzuwenden und danach die Nachbarn zu lesen ist deshalb exakt dasselbe wie
// den Zuschlag beim Lesen jeder Zelle zu addieren - nur ohne einen zusaetzlichen
// Dispatch und ohne eine zusaetzliche Ping-Pong-Textur. Bei einem
// ORTSABHAENGIGEN Regen (wie im Water-Modell, siehe
// shaders/water/pipeFluxUpdate.comp mit seiner rainMap) gaelte das nicht mehr;
// dann muesste der Regen wieder ein eigener Pass werden.
//
// Kartenrand = offene Grenze: Geisterzelle mit derselben Gelaendehoehe wie die
// Randzelle selbst, aber Wassertiefe 0. Wasser am Rand entwaessert dadurch mit
// genau seinem eigenen Pegel als Gefaelle - kein Sonderfall noetig.
layout(local_size_x = 16, local_size_y = 16) in;

layout(r32f, binding = 0) uniform readonly image2D heightMap;
layout(r32f, binding = 1) uniform readonly image2D waterIn;
layout(rgba32f, binding = 2) uniform readonly image2D fluxIn;
layout(r32f, binding = 3) uniform writeonly image2D waterOut;
layout(rgba32f, binding = 4) uniform writeonly image2D fluxOut;

uniform int u_size;
uniform float u_dt;
uniform float u_pipe_area;
uniform float u_gravity;
uniform float u_pipe_length;
uniform float u_rain_per_step;   // rain_rate * RAIN_RATE_TO_DEPTH_M_PER_S * dt

// Wasserspiegel einer Zelle nach dem Regen. Ausserhalb der Karte: nur das
// Gelaende der Randzelle, ohne Wasser (offene Grenze, siehe Header).
float surfaceAt(ivec2 coord) {
    ivec2 clamped = clamp(coord, ivec2(0), ivec2(u_size - 1));
    float bedrock = imageLoad(heightMap, clamped).r;
    bool outside = coord.x < 0 || coord.x >= u_size || coord.y < 0 || coord.y >= u_size;
    if (outside) {
        return bedrock;
    }
    return bedrock + imageLoad(waterIn, clamped).r + u_rain_per_step;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= u_size || coord.y >= u_size) return;

    float surface = surfaceAt(coord);
    float surfaceL = surfaceAt(coord + ivec2(-1, 0));
    float surfaceR = surfaceAt(coord + ivec2(1, 0));
    float surfaceT = surfaceAt(coord + ivec2(0, -1));
    float surfaceB = surfaceAt(coord + ivec2(0, 1));

    vec4 previous = imageLoad(fluxIn, coord);
    float accel = u_dt * u_pipe_area * u_gravity / u_pipe_length;

    float fL = max(0.0, previous.x + accel * (surface - surfaceL));
    float fR = max(0.0, previous.y + accel * (surface - surfaceR));
    float fT = max(0.0, previous.z + accel * (surface - surfaceT));
    float fB = max(0.0, previous.w + accel * (surface - surfaceB));

    // Massenerhaltungs-Skalierung K, jeden Schritt neu: eine Zelle kann nie
    // mehr Wasser abgeben als sie hat. Genau das macht das System
    // unconditionally stable - der Zeitschritt braucht deshalb keine
    // CFL-Bedingung (siehe HydraulicFieldSimulator.MAX_FLOW_VELOCITY_M_S).
    float water = imageLoad(waterIn, coord).r + u_rain_per_step;
    float cellArea = u_pipe_length * u_pipe_length;
    float totalOut = fL + fR + fT + fB;
    float k = min(1.0, (water * cellArea) / max(u_dt * totalOut, 1e-12));

    // Der beregnete Wasserstand wird mit herausgeschrieben - Pass 3
    // (pipeDepth.comp) braucht ihn als Ausgangswert und darf den Regen nicht
    // ein zweites Mal aufschlagen.
    imageStore(waterOut, coord, vec4(water, 0.0, 0.0, 0.0));
    imageStore(fluxOut, coord, vec4(fL * k, fR * k, fT * k, fB * k));
}
